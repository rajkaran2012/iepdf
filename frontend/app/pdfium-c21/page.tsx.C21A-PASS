"use client";

import { useState } from "react";
import { PdfiumCompressorAdapter } from "@/engine/compression/PdfiumCompressorAdapter";

type Analysis = {
  pageIndex: number;
  objectCount: number;
  imageCount: number;
  images: readonly unknown[];
};

export default function PdfiumC21Page() {
  const [file, setFile] = useState<File | null>(null);
  const [running, setRunning] = useState(false);
  const [result, setResult] = useState<Analysis[]>([]);
  const [error, setError] = useState("");

  const runProbe = async () => {
    if (!file) {
      setError("Select a PDF first.");
      return;
    }

    setRunning(true);
    setError("");
    setResult([]);

    const adapter = new PdfiumCompressorAdapter();

    try {
      await adapter.initialize();
      await adapter.openDocument(file);

      const pageCount = adapter.getPageCount();
      const analysis: Analysis[] = [];

      for (let pageIndex = 0; pageIndex < pageCount; pageIndex++) {
        const pageAnalysis =
          await adapter.analyzePageByIndex(pageIndex);

        analysis.push(pageAnalysis);
      }

      adapter.closeDocument();

      console.log("C-21A PDFium analysis:", analysis);
      setResult(analysis);
    } catch (err: unknown) {
      console.error("C-21A failed:", err);

      try {
        adapter.closeDocument();
      } catch {}

      setError(
        err instanceof Error
          ? err.message
          : "C-21A PDFium probe failed."
      );
    } finally {
      setRunning(false);
    }
  };

  return (
    <main className="min-h-screen bg-gray-50 p-8">
      <div className="mx-auto max-w-4xl rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <h1 className="text-2xl font-semibold text-slate-900">
          PDFium C-21A Integration Probe
        </h1>

        <p className="mt-2 text-sm text-slate-600">
          Read-only PDFium document and page analysis.
          No PDF modification or saving.
        </p>

        <div className="mt-6">
          <input
            type="file"
            accept=".pdf,application/pdf"
            onChange={(event) => {
              setFile(event.target.files?.[0] ?? null);
              setResult([]);
              setError("");
            }}
          />
        </div>

        <button
          type="button"
          disabled={!file || running}
          onClick={runProbe}
          className="mt-5 rounded-lg bg-slate-900 px-5 py-2.5 text-sm font-medium text-white disabled:cursor-not-allowed disabled:opacity-50"
        >
          {running ? "Analyzing…" : "Run C-21A Probe"}
        </button>

        {error && (
          <pre className="mt-5 whitespace-pre-wrap rounded-lg bg-red-50 p-4 text-sm text-red-700">
            {error}
          </pre>
        )}

        {result.length > 0 && (
          <pre className="mt-5 overflow-auto rounded-lg bg-slate-950 p-4 text-xs text-slate-100">
            {JSON.stringify(result, null, 2)}
          </pre>
        )}
      </div>
    </main>
  );
}
